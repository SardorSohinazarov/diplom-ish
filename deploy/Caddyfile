# Caddy inside the diplom-site container. HTTPS is handled by the shared proxy on the VPS,
# so this server listens on plain HTTP port 80 inside the "proxy" Docker network only.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		-Server
	}
	header /img/* Cache-Control "public, max-age=604800"
	header /files/* Cache-Control "public, max-age=86400"
	header *.txt Content-Type "text/plain; charset=utf-8"

	file_server

	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}
}
