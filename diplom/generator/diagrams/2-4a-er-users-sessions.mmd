erDiagram
  USERS {
    int Id PK
    string Email "unique"
    string Username "unique"
    string FirstName
    string LastName
    string Bio
    int ProfilePhotoId FK
    bool IsProfileCompleted
    timestamptz CreatedAt
  }
  SESSIONS {
    int Id PK
    int UserId FK
    string DeviceName
    string IpAddress
    string RefreshTokenHash "HMAC-SHA256"
    timestamptz LastActiveAt
    timestamptz ExpiresAt
    timestamptz RevokedAt
  }
  EMAIL_VERIFICATION_CODES {
    int Id PK
    string Email
    string CodeHash "PBKDF2"
    int AttemptCount
    timestamptz ExpiresAt
    timestamptz ConsumedAt
  }
  CONTACTS {
    int Id PK
    int UserId FK
    int ContactUserId FK
    string CustomFirstName
    string CustomLastName
  }
  BLOCKED_USERS {
    int Id PK
    int UserId FK "kim bloklagan"
    int BlockedUserId FK "kim bloklangan"
    timestamptz BlockedAt
  }
  PHOTOS {
    int Id PK
    int FileId FK
    int Width
    int Height
  }
  USERS ||--o{ SESSIONS : "sessiyalari"
